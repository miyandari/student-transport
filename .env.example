# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# فایل .env هرگز نباید commit شود.

# آدرس دیتابیس PostgreSQL
# اگر رمز شامل کاراکتر خاص است (مثل @) باید URL-encode شود: @ -> %40
DATABASE_URL=postgresql+psycopg2://postgres:YourPassword@localhost:5432/student_transport

# کلید امضای JWT (حداقل ۳۲ کاراکتر تصادفی)
# تولید: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
